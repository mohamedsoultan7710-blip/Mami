# Copie ce fichier en ".env.local" et remplis les valeurs (voir README.md).
# Ne jamais mettre ces valeurs entre guillemets, ne jamais les publier sur GitHub.

# Supabase → Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API → "anon public" key
# (non utilisée directement par le code pour l'instant, mais réservée
# pour une évolution future ; tu peux quand même la renseigner)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → "service_role" key (secrète !)
# Ne JAMAIS mettre cette clé dans un fichier envoyé au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe que la maman utilisera pour se connecter sur /admin/login
# (choisis un mot de passe simple mais que les élèves ne devinent pas)
ADMIN_PASSWORD=

# Chaîne secrète quelconque, utilisée uniquement pour sécuriser le cookie
# de connexion. Choisis une suite aléatoire de caractères (peu importe
# laquelle, du moment qu'elle reste secrète).
ADMIN_SESSION_SECRET=
